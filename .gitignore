# ============================================================
# 올리지 않는 것
# ============================================================

# 대화 기록.
#
# 다이아와 나눈 이야기가 통째로 들어 있다. 친밀도·호칭·기분까지.
# 공개 저장소에 올릴 것이 아니다.
memory_store.json
memory_archive/

# 걷어낸 표시 기록 (어떤 몸짓이 왜 나왔는지 따져 보려고 남기는 것)
_cue_log.txt

# 아바타 파일.
#
# 파일 안에 라이선스가 Redistribution_Prohibited 로 박혀 있다.
# 공개 저장소에 두는 것은 재배포다. 쓰려면 직접 넣어야 한다.
static/*.vrm
static/skin/*.png

# 배경 이미지 (개인 파일)
static/background/*
!static/background/읽어주세요.txt

# 단계별로 남겨 둔 원본
_backup_*/

# 파이썬
__pycache__/
*.pyc
*.pyo

# 임시
*.tmp
memory_*.tmp

# 고치기 전에 손으로 떠 둔 원본 (avatar.py.bak_kiss 같은 것).
# 되돌릴 일이 있을 때 쓰려고 남겨 두는 것이라 저장소에는 안 올린다 —
# 판을 낸 뒤로는 git 이력이 같은 일을 한다.
*.bak
*.bak_*

# 계정.
#
# 비밀번호는 되돌릴 수 없는 값으로 바꿔 두었지만, 누가 어떤 아이디를
# 쓰는지까지 올릴 이유가 없다.
accounts.json

# 쿠키에 서명하는 열쇠. 이게 새면 남의 쿠키를 지어낼 수 있다.
.secret_key

# 사람마다 갈라 둔 기억. memory_store.json 과 같은 이유로 올리지 않는다.
memory/
.vercel
.env*

# 터널 실행 파일(cloudflared). 받아 쓰는 것이라 저장소에 둘 이유가 없다.
_tools/

# 올릴 때마다 새로 적히는 지문. 올린 것이 방금 그것인지 확인하는 데만 쓴다.
build.json

# 목소리 만드는 열쇠(Gemini). 새면 남이 내 몫을 쓴다.
.gemini_key

# 만들어 둔 목소리. 다시 만들 수 있는 것이라 안 올린다.
_voice_cache/

# 옷장에 구운 옷도 아바타에서 떼어 낸 것이다.
#
# `static/*.vrm` 은 한 칸 아래인 wardrobe/ 를 못 덮는다(* 는 / 를 안 넘는다).
# 안 적어 두면 교복.vrm 이 그대로 공개 저장소로 올라간다 — 원본에
# Redistribution_Prohibited 가 박힌 물건에서 뽑은 것이라 그러면 안 된다.
# 옷장 목록(wardrobe.json)은 모델이 아니라 표라서 올린다.
static/wardrobe/*.vrm
